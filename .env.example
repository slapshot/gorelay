# Example only. Use a protected systemd environment file, never commit credentials.
GORELAY_LISTEN_ADDR=127.0.0.1:8092
GORELAY_DATABASE_URL=postgres://gorelay_runtime:REPLACE_ME@127.0.0.1:5432/gorelay?sslmode=disable
GORELAY_CLIENTS_FILE=/etc/gorelay/clients.json
GORELAY_MAX_BODY_BYTES=262144
# Explicit opt-in: admits PENDING events but DOES NOT dispatch them yet.
GORELAY_ENABLE_ADMISSION_PREVIEW=false
# Each token must be a unique high-entropy credential (minimum 32 characters).
GORELAY_TOKEN_DEMO=REPLACE_WITH_RANDOM_HIGH_ENTROPY_TOKEN
